{
  "name": "dsh-sync-hub",
  "version": "0.5.0",
  "description": "同步多台电脑上的 DSH 配置与会话：可选的同步范围、三种传输通道、冲突检测与回滚。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "lib",
    "!lib/**/*.test.mjs",
    "locale",
    "README.md",
    "LICENSE",
    "docs",
    "tests/smoke.mjs",
    "tests/secrets.test.mjs",
    "tests/transport.test.mjs",
    "tests/git-guard.test.mjs",
    "tests/analysis.test.mjs",
    "tests/session-canon.test.mjs",
    "tests/cross-machine.test.mjs",
    "tests/defensive.test.mjs"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0",
    "node": ">=22.19"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sync",
    "backup",
    "sessions",
    "config-sync",
    "session-sync",
    "multi-device",
    "developer-tools",
    "settings-backup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveliveao/dsh-sync-hub.git"
  },
  "bugs": {
    "url": "https://github.com/loveliveao/dsh-sync-hub/issues"
  },
  "homepage": "https://github.com/loveliveao/dsh-sync-hub#readme",
  "license": "MIT",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "author": {
    "name": "loveliveao",
    "url": "https://github.com/loveliveao"
  }
}
